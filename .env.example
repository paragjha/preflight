# Semantic engine: rules (default, no key, no network) | llm | both
SEMANTIC_ENGINE=rules

# Only needed when SEMANTIC_ENGINE is "llm" or "both".
# Get a free key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-key-here

# Catalog resolver (GTIN -> existing ZSKU): off (default) | mock | http
# CATALOG_RESOLVER=off
# For http: the customer's own catalog endpoint + optional bearer token
# CATALOG_RESOLVER_URL=https://your-catalog.example/lookup
# CATALOG_RESOLVER_KEY=your-token
